---
    import { Image } from 'astro:assets';
    import Layout from '../../layouts/Layout.astro';
    import { ProductoDetalleSchema } from '../../schemas/producto';
    import AddToCartButton from '../../components/AddToCartButton';

    const API_URL = import.meta.env.PUBLIC_API_URL;
    const { slug } = Astro.params;

    const res = await fetch(`${API_URL}/store/productos/${slug}`);

    if (res.status === 404) {
        return Astro.redirect('/404');
    }

    const producto = ProductoDetalleSchema.parse(await res.json());
    const apiUrl = API_URL.replace('/api', '');
    const imagenPrincipal = producto.imagenes.find((i) => i.principal) ?? producto.imagenes[0];

    const mostrarTamanos = (producto.variantes?.tamanos.length ?? 0) > 0;
    const mostrarColores = (producto.variantes?.colores.length ?? 0) > 0;
---

<Layout title={producto.meta_title ?? producto.nombre} description={producto.meta_description ?? undefined}>
    <main class="max-w-4xl mx-auto px-4 py-12 grid md:grid-cols-2 gap-8">
        <div class="aspect-square bg-stone-100 rounded-lg overflow-hidden relative">
            {producto.porcentaje_descuento && (
                <span class="absolute top-3 left-3 bg-red-600 text-white text-xs font-bold px-2 py-1 rounded-md z-10">
                    -{producto.porcentaje_descuento}%
                </span>
            )}
            {imagenPrincipal && (
                <Image
                    src={`${apiUrl}/storage/${imagenPrincipal.url}`}
                    alt={producto.nombre}
                    width={800}
                    height={800}
                    loading="lazy"
                    class="w-full h-full object-cover"
                    transition:name="producto-imagen"
                />
            )}
        </div>

        <div>
            <h1 class="text-2xl font-semibold" transition:name="producto-nombre">{producto.nombre}</h1>

            <p class="text-2xl font-bold text-stone-900 mt-2" transition:name="producto-precio">
                {producto.precio_oferta ? (
                    <>
                        <span class="line-through text-stone-400 text-lg mr-2 font-normal">
                            ${producto.precio.toLocaleString('es-AR')}
                        </span>
                        <span>${producto.precio_oferta.toLocaleString('es-AR')}</span>
                    </>
                ) : (
                    <>${producto.precio.toLocaleString('es-AR')}</>
                )}
            </p>

            {(mostrarTamanos || mostrarColores) && (
                <div class="mt-5 space-y-4">
                    {mostrarTamanos && (
                        <div>
                            <p class="text-sm font-medium text-stone-700 mb-2">
                                Tamaño:{' '}
                                <span class="font-normal text-stone-500">{producto.variante_tamano}</span>
                            </p>
                            <div class="flex flex-wrap gap-2">
                                {producto.variantes!.tamanos.map((t) =>
                                    t.disponible ? (
                                        <a
                                            href={`/productos/${t.slug}`}
                                            class={`px-3 py-1.5 text-sm rounded-full border transition-colors ${
                                                t.valor === producto.variante_tamano
                                                    ? 'border-stone-900 bg-stone-900 text-white'
                                                    : 'border-stone-300 text-stone-700 hover:border-stone-500'
                                            }`}
                                        >
                                            {t.valor}
                                        </a>
                                    ) : (
                                        <span
                                            class="px-3 py-1.5 text-sm rounded-full border border-stone-200 text-stone-300 cursor-not-allowed"
                                            title="No disponible en esta combinación"
                                        >
                                            {t.valor}
                                        </span>
                                    )
                                )}
                            </div>
                        </div>
                    )}

                    {mostrarColores && (
                        <div>
                            <p class="text-sm font-medium text-stone-700 mb-2">
                                Color:{' '}
                                <span class="font-normal text-stone-500">
                                    {producto.variante_color_nombre}
                                </span>
                            </p>
                            <div class="flex flex-wrap gap-2">
                                {producto.variantes!.colores.map((c) =>
                                    c.disponible ? (
                                        <a
                                            href={`/productos/${c.slug}`}
                                            title={c.valor}
                                            class={`w-8 h-8 rounded-full border-2 ${
                                                c.valor === producto.variante_color_nombre
                                                    ? 'border-stone-900'
                                                    : 'border-transparent'
                                            }`}
                                            style={{ backgroundColor: c.hex ?? '#e7e5e4' }}
                                        />
                                    ) : (
                                        <span
                                            title={`${c.valor} — no disponible en esta combinación`}
                                            class="w-8 h-8 rounded-full border-2 border-transparent opacity-30 cursor-not-allowed"
                                            style={{ backgroundColor: c.hex ?? '#e7e5e4' }}
                                        />
                                    )
                                )}
                            </div>
                        </div>
                    )}
                </div>
            )}

            {producto.descripcion && (
                <p class="text-stone-600 mt-4">{producto.descripcion}</p>
            )}

            <div class="mt-6">
                {producto.stock > 0 ? (
                    <p class="text-sm text-green-700">En stock ({producto.stock} disponibles)</p>
                ) : (
                    <p class="text-sm text-red-600">Sin stock</p>
                )}
            </div>

            <AddToCartButton producto={producto} imagen={imagenPrincipal?.url ?? null} client:load />
        </div>
    </main>
</Layout>
