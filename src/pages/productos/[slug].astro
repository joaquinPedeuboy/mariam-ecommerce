---
    import Layout from '../../layouts/Layout.astro';
    import FavoritoButton from '../../components/FavoritoButton';
    import ProductCarousel from '@/components/ui/ProductCarousel.astro';
    import ProductGallery from '@/components/ui/ProductGallery.astro';
    import { ProductoDetalleSchema } from '../../schemas/producto';
    import AddToCartButton from '../../components/AddToCartButton';

    const API_URL = import.meta.env.PUBLIC_API_URL;
    const { slug } = Astro.params;

    const res = await fetch(`${API_URL}/store/productos/${slug}`);

    if (res.status === 404) {
        return Astro.redirect('/404');
    }

    const producto = ProductoDetalleSchema.parse(await res.json());
    const apiUrl = API_URL.replace('/api', '');
    const imagenPrincipal = producto.imagenes.find((i) => i.principal) ?? producto.imagenes[0];

    const mostrarTamanos = (producto.variantes?.tamanos.length ?? 0) > 0;
    const mostrarColores = (producto.variantes?.colores.length ?? 0) > 0;
---

<Layout title={producto.meta_title ?? producto.nombre} description={producto.meta_description ?? undefined}>
    <main class="max-w-6xl mx-auto px-4 py-4">
        <!-- Breadcrumb --> 
        <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center text-sm text-stone-500" font-poppins aria-label="Breadcrumb"> 
            <a href="/productos" class="text-sm text-stone-500 hover:text-stone-900 transition-colors" >
                Productos 
            </a> 
            <span class="mx-2 text-stone-300">/</span> 
            {producto.categorias.map((cat, index) => (
                <span>
                    <a href={`/productos?categoria=${cat.slug}`} class="text-sm text-stone-500 hover:text-stone-900 transition-colors">
                        {cat.nombre}
                    </a>
                    {index < producto.categorias.length - 1 && <span class="mx-2 text-stone-300">/</span>}
                </span>
            ))} 
        </nav>
        <div class="grid md:grid-cols-2 gap-10 lg:gap-16 xl:gap20">
            <ProductGallery
                imagenes={producto.imagenes}
                apiUrl={apiUrl}
                nombre={producto.nombre}
                porcentajeDescuento={producto.porcentaje_descuento}
            />
    
            <div>
                <div class="flex items-start justify-between gap-4 mt-2">
                    <h1 class="text-2xl font-semibold font-poppins text-stone-900 leading-tight" transition:name="producto-nombre">{producto.nombre}</h1>
                    <FavoritoButton productoEcommerceId={producto.id} client:load />
                </div>
    
                <p class="text-2xl font-bold text-stone-900 mt-5" transition:name="producto-precio">
                    {producto.precio_oferta ? (
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                            <span class="text-lg text-stone-400 line-through">
                                ${producto.precio.toLocaleString('es-AR')}
                            </span>
                            <span class="text-3xl sm:text-4xl font-bold text-stone-900">
                                ${producto.precio_oferta.toLocaleString('es-AR')}
                            </span>
                            <span class="bg-violet-800 text-white text-sm font-bold px-2 py-1 rounded-full ml-2">
                                -{producto.porcentaje_descuento}%
                            </span>
                        </div>
                    ) : (
                        <span class="text-3xl sm:text-4xl font-bold text-stone-900"> ${producto.precio.toLocaleString('es-AR')} </span>
                    )}
                    <!-- <span>CFTEA 0% Precio sin impuestos nacionales: ${producto.precio_sin_impuestos.toLocaleString('es-AR')}</span> -->
                </p>

                <div class="border-t border-stone-200 my-7"></div>
    
                {(mostrarTamanos || mostrarColores) && (
                    <div class="space-y-6">
                        {mostrarTamanos && (
                            <div>

                                <div class="flex items-center gap-2 mb-3">
                                    <p class="text-sm font-medium text-stone-700">
                                        Tamaño:
                                    </p>
                                    <span class="text-sm text-stone-500">{producto.variante_tamano}</span>
                                </div>

                                <div class="flex flex-wrap gap-2">
                                    {producto.variantes!.tamanos.map((t) =>
                                        t.disponible ? (
                                            <a
                                                href={`/productos/${t.slug}`}
                                                class={`min-w-17.5 px-4 py-2.5 text-sm text-center rounded-lg border transition-all duration-200 ${
                                                    t.valor === producto.variante_tamano
                                                        ? 'border-stone-900 bg-stone-900 text-white shadow-sm'
                                                        : 'border-stone-300 text-stone-700 hover:border-stone-700'
                                                }`}
                                            >
                                                {t.valor}
                                            </a>
                                        ) : (
                                            <span
                                                class="min-w-17.5 px-4 py-2.5 text-sm text-center rounded-lg border border-stone-200 text-stone-300 line-through cursor-not-allowed"
                                                title="No disponible en esta combinación"
                                            >
                                                {t.valor}
                                            </span>
                                        )
                                    )}
                                </div>
                            </div>
                        )}
    
                        {mostrarColores && ( 
                            <div> 
                                <div class="flex items-center gap-2 mb-3"> 
                                    <p class="text-sm font-semibold text-stone-800"> 
                                        Color 
                                    </p> 
                                    <span class="text-sm text-stone-500"> {producto.variante_color_nombre} </span> 
                                </div> 
                                <div class="flex flex-wrap gap-3"> 
                                    {producto.variantes!.colores.map((c) => c.disponible ? ( 
                                        <a 
                                            href={`/productos/${c.slug}`} 
                                            title={c.valor} 
                                            aria-label={`Color ${c.valor}`} 
                                            class={` w-9 h-9 rounded-full flex items-center justify-center transition-all duration-200 ${ c.valor === producto.variante_color_nombre ? 'ring-2 ring-stone-900 ring-offset-2' : 'hover:ring-2 hover:ring-stone-300 hover:ring-offset-2' } `} 
                                        > 
                                            <span class="w-full h-full rounded-full border border-black/10" style={{ backgroundColor: c.hex ?? '#e7e5e4' }} /> 
                                        </a> 
                                        ) : ( 
                                        <span title={`${c.valor} — no disponible en esta combinación`} class="w-9 h-9 rounded-full border border-stone-200 opacity-30 cursor-not-allowed relative" style={{ backgroundColor: c.hex ?? '#e7e5e4' }} > 
                                            <span class="absolute top-1/2 left-0 w-full h-px bg-stone-500 rotate-45" /> 
                                        </span> 
                                        ) )} 
                                </div> 
                            </div> 
                        )} 
                    </div> 
                )}
                
                <div class="mt-8"> <AddToCartButton producto={producto} imagen={imagenPrincipal?.url ?? null} client:load /> </div>

                <!-- Información adicional --> 
                
                
                <!-- Descripción -->
                <div class="border-t border-stone-200 my-7"></div>
                {producto.descripcion && ( 
                    <h2 class="text-lg font-semibold font-poppins text-stone-900" > 
                        Descripción 
                    </h2> 
                    <p class="mt-4 text-stone-600 leading-relaxed font-normal text-base sm:text-lg" > {producto.descripcion} </p> 
                )}
            </div>
        </div>
        
    </main>

    <ProductCarousel titulo="También te puede interesar" productos={producto.relacionados} />
</Layout>
