---
import Layout from '../layouts/Layout.astro';
import RegisterForm from '../components/RegisterForm';
---

<Layout title="Crear cuenta - Perfumería">
    <main class="min-h-screen flex items-center justify-center px-4 py-12">
        <div class="w-full max-w-sm">
            <h1 class="text-2xl font-semibold text-center mb-6">Crear cuenta</h1>
            <RegisterForm client:load />
            <p class="text-center text-sm text-stone-500 mt-4">
                ¿Ya tenés cuenta? <a href="/login" class="text-stone-900 underline">Ingresá acá</a>
            </p>
        </div>
    </main>
</Layout>