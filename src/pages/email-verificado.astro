---
    import "../styles/global.css"
    const estado = Astro.url.searchParams.get('estado');

    const yaVerificado = estado === 'ya-verificado';

    const titulo = yaVerificado
        ? 'Tu email ya estaba verificado'
        : '¡Email verificado!';

    const mensaje = yaVerificado
        ? 'Este enlace ya fue utilizado. Tu cuenta está correctamente verificada.'
        : 'Tu dirección de email fue verificada correctamente. Ya podés continuar disfrutando de Mariam.';

    const logo = '/logo/mariam_isotipo_transparente.png';
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        
        <title>{titulo} | Mariam</title>
    </head>

    <body class="min-h-screen bg-slate-200 font-Poppins">
        <main class="flex min-h-screen items-center justify-center px-4 py-8">
            <section
                class="w-full max-w-sm rounded-3xl bg-white px-6 py-8 text-center shadow-lg"
            >
                <img
                    src={logo}
                    alt="Mariam"
                    class="mx-auto mb-6 h-auto w-28"
                />

                <div
                    class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="4"
                        class="h-8 w-8 text-green-700"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="m5 12 4 4L19 6"
                        />
                    </svg>
                </div>

                <h1
                    class="mb-3 font-fraunces text-2xl font-semibold italic text-[#5b3a82]"
                >
                    {titulo}
                </h1>

                <p class="mb-6 text-sm leading-6 text-gray-600 font-poppins">
                    {mensaje}
                </p>

                <a
                    href="/"
                    class="inline-flex w-full items-center justify-center rounded-xl bg-violet-600 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-violet-800"
                >
                    Ir a la tienda
                </a>
            </section>
        </main>
    </body>
</html>