---
	const apiUrl = import.meta.env.PUBLIC_API_URL.replace('/api', '');
	let apiStatus = 'desconocido';

	try {
		const res = await fetch(`${apiUrl}/up`);
		apiStatus = res.ok ? 'conectado ✅' : 'con problemas ⚠️';
	} catch {
		apiStatus = 'no responde ❌';
	}
---

<main class="min-h-screen flex items-center justify-center bg-stone-50">
	<div class="text-center">
		<h1 class="text-3xl font-semibold text-stone-900">Storefront en construcción</h1>
		<p class="text-stone-600 mt-2">Estado de la API: {apiStatus}</p>
	</div>
</main>