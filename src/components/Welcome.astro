---
	import HeroBanner from '@/components/ui/HeroBanner.astro';
	import ProductCarousel from '@/components/ui/ProductCarousel.astro';
	import { PaginatedSchema, ProductoListItemSchema } from '@/schemas/producto';

	const API_URL = import.meta.env.PUBLIC_API_URL;

	async function obtenerProductos(query: string) {
		try {
			const res = await fetch(`${API_URL}/store/productos?${query}`);
			if (!res.ok) return [];
			const data = PaginatedSchema(ProductoListItemSchema).parse(await res.json());
			return data.data;
		} catch {
			// Si la API no responde, la homepage igual se muestra, solo sin
			// ese carrusel puntual.
			return [];
		}
	}

	const [ofertas, destacados] = await Promise.all([
		obtenerProductos('en_oferta=true&per_page=12'),
		obtenerProductos('destacados=true&per_page=12'),
	]);
---

<main>
    <HeroBanner />
    <ProductCarousel titulo="Ofertas del Mes" productos={ofertas} />
    <ProductCarousel titulo="Destacados de Mariam" productos={destacados} />
</main>
