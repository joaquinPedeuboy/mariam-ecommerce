---
    import CategoryFilter from './CategoryFilter.astro'; 
    interface Categoria { nombre: string; slug: string; subcategorias: Categoria[]; } 
    interface Props { 
        categorias: Categoria[]; 
        categoriaSeleccionada: string; 
        precioMin: string; 
        precioMax: string; 
        enOferta: boolean; 
        destacados: boolean; 
        busqueda: string; 
        orden: string; 
        hayFiltros: boolean; 
        crearUrl: ( cambios: Record<string, string | null> ) => string; 
    } 

    const { 
        categorias, 
        categoriaSeleccionada, 
        precioMin, 
        precioMax, 
        enOferta, 
        destacados, 
        busqueda, 
        orden, 
        hayFiltros, 
        crearUrl, 
    } = Astro.props;

---

<!-- Botón filtros mobile -->
<button
    type="button"
    id="abrir-filtros"
    class="flex items-center gap-2 text-sm text-stone-700 lg:hidden cursor-pointer"
>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
    </svg>

    Filtrar

    {hayFiltros && (
        <span class="w-2 h-2 rounded-full bg-stone-900"></span>
    )}
</button>


<!-- Botón filtros desktop -->
<button
    type="button"
    id="abrir-filtros-desktop"
    class="hidden lg:flex items-center gap-2 text-md text-stone-700 hover:text-stone-900 cursor-pointer"
>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
    </svg>

    Filtrar

    {hayFiltros && (
        <span class="w-2 h-2 rounded-full bg-stone-900"></span>
    )}
</button>


<!-- PANEL -->
<div
    id="filtros-panel"
    class="fixed inset-0 z-50 hidden"
>
    <!-- Fondo -->
    <button
        type="button"
        id="cerrar-filtros-fondo"
        aria-label="Cerrar filtros"
        class="absolute inset-0 bg-black/30 backdrop-blur-[1px] cursor-pointer"
    ></button>


    <!-- Contenido -->
    <aside
        id="filtros-contenido"
        class="absolute left-0 top-0 h-full w-full max-w-sm bg-white shadow-xl overflow-y-auto transform -translate-x-full transition-transform duration-300"
    >
        <div class="min-h-full flex flex-col">

            <!-- HEADER -->
            <div class="flex items-center justify-between px-5 py-5 border-b border-stone-200">
                <div>
                    <p class="text-xs uppercase tracking-[0.16em] text-stone-400">
                        Catálogo
                    </p>

                    <h2 class="font-serif text-xl text-stone-900 mt-1">
                        Filtros
                    </h2>
                </div>

                <button
                    type="button"
                    id="cerrar-filtros"
                    aria-label="Cerrar filtros"
                    class="w-9 h-9 rounded-full flex items-center justify-center text-stone-500 hover:bg-stone-100 hover:text-stone-900 cursor-pointer transition-colors"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="19"
                        height="19"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M18 6 6 18" />
                        <path d="m6 6 12 12" />
                    </svg>
                </button>
            </div>


            <!-- FORMULARIO -->
            <form
                id="filtros-form"
                method="GET"
                class="flex-1"
            >
                {busqueda && (
                    <input
                        type="hidden"
                        name="busqueda"
                        value={busqueda}
                    />
                )}

                {orden !== 'relevancia' && (
                    <input
                        type="hidden"
                        name="orden"
                        value={orden}
                    />
                )}


                <div class="px-5 py-6 space-y-8">

                    <!-- CATEGORÍAS -->
                    <section>
                        <h3 class="text-sm font-medium text-stone-900 mb-4">
                            Categorías
                        </h3>

                        <div class="space-y-1">
                            {categorias.map((categoria) => (
                                <CategoryFilter
                                    categoria={categoria}
                                    categoriaSeleccionada={categoriaSeleccionada}
                                    crearUrl={crearUrl}
                                />
                            ))}
                        </div>
                    </section>


                    <!-- PRECIO -->
                    <section>
                        <h3 class="text-sm font-medium text-stone-900 mb-4">
                            Precio
                        </h3>

                        <div class="grid grid-cols-2 gap-3">

                            <label class="block">
                                <span class="block text-xs text-stone-500 mb-1.5">
                                    Mínimo
                                </span>

                                <div class="relative">
                                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-xs text-stone-400">
                                        $
                                    </span>

                                    <input
                                        type="number"
                                        name="precio_min"
                                        value={precioMin}
                                        min="0"
                                        placeholder="0"
                                        class="w-full border border-stone-300 rounded-md pl-7 pr-3 py-2.5 text-sm text-stone-800 outline-none focus:border-stone-500 focus:ring-1 focus:ring-stone-200 transition-colors"
                                    />
                                </div>
                            </label>


                            <label class="block">
                                <span class="block text-xs text-stone-500 mb-1.5">
                                    Máximo
                                </span>

                                <div class="relative">
                                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-xs text-stone-400">
                                        $
                                    </span>

                                    <input
                                        type="number"
                                        name="precio_max"
                                        value={precioMax}
                                        min="0"
                                        placeholder="0"
                                        class="w-full border border-stone-300 rounded-md pl-7 pr-3 py-2.5 text-sm text-stone-800 outline-none focus:border-stone-500 focus:ring-1 focus:ring-stone-200 transition-colors"
                                    />
                                </div>
                            </label>

                        </div>
                    </section>


                    <!-- TIPO -->
                    <section>
                        <h3 class="text-sm font-medium text-stone-900 mb-4">
                            Tipo de producto
                        </h3>

                        <div class="space-y-1">

                            <label class="flex items-center gap-3 py-2 text-sm text-stone-600 cursor-pointer group">
                                <input
                                    type="checkbox"
                                    name="en_oferta"
                                    value="1"
                                    checked={enOferta}
                                    class="w-4 h-4 accent-stone-900 cursor-pointer"
                                />

                                <span class="group-hover:text-stone-900 transition-colors">
                                    Solo productos en oferta
                                </span>
                            </label>


                            <label class="flex items-center gap-3 py-2 text-sm text-stone-600 cursor-pointer group">
                                <input
                                    type="checkbox"
                                    name="destacados"
                                    value="1"
                                    checked={destacados}
                                    class="w-4 h-4 accent-stone-900 cursor-pointer"
                                />

                                <span class="group-hover:text-stone-900 transition-colors">
                                    Solo productos destacados
                                </span>
                            </label>

                        </div>
                    </section>

                </div>


                <!-- FOOTER -->
                <div class="sticky bottom-0 bg-white border-t border-stone-200 px-5 py-4">

                    <div class="flex items-center gap-3">

                        <a
                            href="/productos"
                            class="flex-1 text-center border border-stone-300 rounded-md py-2.5 text-sm text-stone-700 hover:bg-stone-50 transition-colors"
                        >
                            Limpiar
                        </a>

                        <button
                            type="submit"
                            class="flex-1 bg-stone-900 text-white rounded-md py-2.5 text-sm font-medium hover:bg-stone-800 transition-colors cursor-pointer"
                        >
                            Aplicar filtros
                        </button>

                    </div>

                </div>

            </form>

        </div>
    </aside>
</div>


<script>
    const panel = document.getElementById('filtros-panel');
    const contenido = document.getElementById('filtros-contenido');

    const abrirMobile =
        document.getElementById('abrir-filtros');

    const abrirDesktop =
        document.getElementById('abrir-filtros-desktop');

    const cerrar =
        document.getElementById('cerrar-filtros');

    const cerrarFondo =
        document.getElementById('cerrar-filtros-fondo');


    function abrirPanel() {
        if (!panel || !contenido) return;

        panel.classList.remove('hidden');

        requestAnimationFrame(() => {
            contenido.classList.remove('-translate-x-full');
        });

        document.body.classList.add('overflow-hidden');
    }


    function cerrarPanel() {
        if (!panel || !contenido) return;

        contenido.classList.add('-translate-x-full');

        setTimeout(() => {
            panel.classList.add('hidden');
        }, 300);

        document.body.classList.remove('overflow-hidden');
    }


    abrirMobile?.addEventListener(
        'click',
        abrirPanel
    );

    abrirDesktop?.addEventListener(
        'click',
        abrirPanel
    );

    cerrar?.addEventListener(
        'click',
        cerrarPanel
    );

    cerrarFondo?.addEventListener(
        'click',
        cerrarPanel
    );


    document.addEventListener(
        'keydown',
        (event) => {
            if (event.key === 'Escape') {
                cerrarPanel();
            }
        }
    );
</script>