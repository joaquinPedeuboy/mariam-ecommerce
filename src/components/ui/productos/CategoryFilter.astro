---
    import CategoryFilter from '@/components/ui/productos/CategoryFilter.astro'
    interface Categoria {
        nombre: string;
        slug: string;
        subcategorias: Categoria[];
    }

    interface Props {
        categoria: Categoria;
        categoriaSeleccionada: string;
        crearUrl: (
            cambios: Record<string, string | null>
        ) => string;
        nivel?: number;
    }

    const {
        categoria,
        categoriaSeleccionada,
        crearUrl,
        nivel = 0,
    } = Astro.props;

    function contieneCategoria(
        cat: Categoria,
        slug: string
    ): boolean {
        if (cat.slug === slug) {
            return true;
        }

        return cat.subcategorias.some((sub) =>
            contieneCategoria(sub, slug)
        );
    }

    const tieneHijos = categoria.subcategorias.length > 0;

    const estaEnRuta = categoriaSeleccionada
        ? contieneCategoria(categoria, categoriaSeleccionada)
        : false;

    const esSeleccionada =
        categoria.slug === categoriaSeleccionada;
---
{tieneHijos ? (
    <details
        class="group"
        open={estaEnRuta}
    >
        <summary
            class="flex items-center justify-between gap-3 py-2.5 cursor-pointer list-none marker:hidden"
        >
            <span
                class={`text-sm transition-colors ${
                    esSeleccionada
                        ? 'text-stone-900 font-medium'
                        : 'text-stone-600 group-hover:text-stone-900'
                }`}
                style={`padding-left: ${nivel * 14}px`}
            >
                {categoria.nombre}
            </span>

            <span
                class="w-7 h-7 shrink-0 flex items-center justify-center rounded-md text-stone-400 hover:text-stone-900 hover:bg-stone-50 transition-colors"
            >

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="transition-transform duration-200 group-open:rotate-180"
                >
                    <path d="m6 9 6 6 6-6" />
                </svg>

            </span>

        </summary>

        <div
            class="border-l border-stone-200 ml-3 pl-1"
        >
            <a
                href={crearUrl({
                    categoria: categoria.slug,
                    page: null,
                })}
                class={`block py-2 text-sm transition-colors ${
                    esSeleccionada
                        ? 'text-stone-900 font-medium'
                        : 'text-stone-400 hover:text-stone-900'
                }`}
                style={`padding-left: ${(nivel + 1) * 14}px`}
            >
                Ver todo
            </a>

            {categoria.subcategorias.map(
                (subcategoria) => (

                    <CategoryFilter
                        categoria={subcategoria}
                        categoriaSeleccionada={categoriaSeleccionada}
                        crearUrl={crearUrl}
                        nivel={nivel + 1}
                    />

                )
            )}
        </div>
    </details>

) :(
    <a
        href={crearUrl({
            categoria: categoria.slug,
            page: null,
        })}
        class={`block py-2.5 text-sm transition-colors ${
            esSeleccionada
                ? 'text-stone-900 font-medium'
                : 'text-stone-600 hover:text-stone-900'
        }`}
        style={`padding-left: ${nivel * 14}px`}
    >
        {categoria.nombre}
    </a>
)}
