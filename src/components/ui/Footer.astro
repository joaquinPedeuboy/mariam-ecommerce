---
import { Picture } from "astro:assets";
import FooterBox from "./FooterBox.astro";

---

<footer class="bg-stone-200 p-10 md:pt-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 lg:gap-10">
        <div class="max-w-4xl mx-auto mt-2 grid grid-cols-2 md:flex md:flex-col items-center">
            
            <FooterBox
                heading="Tres generaciones. El mismo compromiso"
            />
            
        </div>
        <div class="md:hidden w-1/4 h-1 bg-marron-tierra mx-auto m-2 rounded"></div>
        <FooterBox heading="Nuestras Redes">

            <div class="flex flex-row text-center gap-2 mt-4 ">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10" /><path d="M3 7l9 6l9 -6" /></svg>
                <p class="font-sans font-medium text-lg">LaMary@correo.com</p>
            </div>

            <div class="flex flex-row text-center gap-2 mt-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-brand-facebook"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3" /></svg>
                <p class="font-sans font-medium text-lg">La Mary</p>
            </div>

            <div class="flex flex-row text-center gap-2 mt-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8" /><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" /><path d="M16.5 7.5v.01" /></svg>
                <p class="font-sans font-medium">@LaMary</p>
            </div>

            <div class="flex flex-row text-center gap-2 mt-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-device-mobile"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M6 5a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2v-14" /><path d="M11 4h2" /><path d="M12 17v.01" /></svg>
                <p class="font-sans font-medium text-lg">+54 (2324)555456</p>
            </div>

            <div class="flex flex-row text-center gap-2 mt-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-brand-whatsapp"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" /><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" /></svg>
                <p class="font-sans font-medium text-lg">+54 (2324)555456</p>
            </div>

        </FooterBox>
    </div>

    <p class="py-10 text-center text-crema-natural text-sm">
        Todos los derechos reservados. Perfumería Mariam. &copy; {new Date().getFullYear() }
    </p>
</footer>