---
    import CategoryMenuList from './CategoryMenuList.astro';
    import { CategoriasResponseSchema, type CategoriasResponse } from '../../schemas/categoria';

    const API_URL = import.meta.env.PUBLIC_API_URL;

    let categorias: CategoriasResponse = {
        menu_principal: [],
        hamburguesa: [],
    };

    try {
        const res = await fetch(`${API_URL}/store/categorias`);
        if (res.ok) {
            categorias = CategoriasResponseSchema.parse(await res.json());
        }
    } catch {
        // Si la API no responde, el header igual se muestra, solo sin categorías
    }
---

<nav class="relative border-t border-stone-100 bg-white">
    <!-- DESKTOP -->

    <div class="hidden md:flex items-center h-16 px-6">

        <!-- Botón hamburguesa -->
        <button
            id="menu-toggle-desktop"
            type="button"
            class="shrink-0 w-30 h-10 flex items-center justify-center gap-1
                rounded-md text-stone-600
                hover:text-stone-950 hover:bg-stone-50
                transition-colors
                cursor-pointer ml-16"
                aria-label="Abrir menú de categorías"
                aria-expanded="false"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-6 h-6"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
                />
            </svg>
            <span class="text-sm font-poppins font-medium">Categorías</span>
        </button>

        <!-- Categorías principales -->
        <div class="flex-1 flex items-center justify-center gap-10">
            {categorias.menu_principal.map((categoria) => (
                <div class="group h-16 flex items-center">
                    <a
                        href={`/productos?categoria=${categoria.slug}`}
                        class="relative px-3 py-2 text-sm text-stone-600
                                font-poppins font-medium
                                transition-colors duration-200
                                hover:text-stone-950"
                    >
                        {categoria.nombre}
                    </a>

                    {categoria.subcategorias.length > 0 && (
                        <div
                            class="absolute left-1/2 top-[calc(100%+12px)]
                                    -translate-x-1/2
                                    invisible opacity-0 translate-y-1
                                    group-hover:visible
                                    group-hover:opacity-100
                                    group-hover:translate-y-0
                                    transition-all duration-200 ease-out
                                    bg-white border border-stone-200/80
                                    rounded-xl shadow-xl
                                    shadow-stone-900/10
                                    p-8
                                    w-[calc(100vw-48px)]
                                    max-w-[1400px]
                                    z-30"
                        >
                            <div
                                class="grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))]
                                        gap-x-10 gap-y-6"
                            >
                                {categoria.subcategorias.map((sub) => (
                                    <div class="min-w-0">
                                        <a
                                            href={`/productos?categoria=${sub.slug}`}
                                            class="block text-sm font-poppins
                                                    font-semibold text-stone-800
                                                    mb-4 pl-2
                                                    transition-colors
                                                    hover:text-black"
                                        >
                                            {sub.nombre}
                                        </a>

                                        {sub.subcategorias.length > 0 && (
                                            <CategoryMenuList
                                                categorias={sub.subcategorias}
                                            />
                                        )}
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}
                </div>
            ))}
        </div>
    </div>

    <!-- MOBILE -->

    <div class="md:hidden h-14 flex items-center px-4">

        <button
            id="menu-toggle-mobile"
            type="button"
            class="flex items-center gap-2 text-stone-700
            hover:text-stone-950 transition-colors"
            aria-label="Abrir categorías"
            aria-expanded="false"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-6 h-6"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
                />
            </svg>

            <span class="text-sm font-poppins font-medium">
                Categorías
            </span>
        </button>
    </div>

    <!-- MENÚ HAMBURGUESA DESKTOP -->

    <div
    id="desktop-menu"
    class="hidden absolute left-0 top-full w-full
            shadow-[0_12px_30px_rgba(0,0,0,0.08)]
            z-50"
    >
        <div class="max-w-8xl mx-auto px-6 py-7">
            <!-- CONTENEDOR PRINCIPAL -->

            <div
                class="grid grid-cols-[240px_1fr]
                    rounded-md
                    overflow-hidden
                    h-[min(500px,calc(100vh-190px))]
                    "
            >
                <!-- CATEGORÍAS PADRE -->

                <div
                    class="bg-stone-200
                        overflow-y-auto
                        overscroll-contain
                        p-3"
                >

                    <p
                        class="px-4 pt-2 pb-3
                            text-[10px]
                            uppercase
                            tracking-[0.18em]
                            font-poppins
                            font-semibold
                            text-stone-400"
                    >
                        Categorías
                    </p>


                    {categorias.hamburguesa.map((categoria, index) => (
                        <button
                            type="button"
                            data-category-index={index}
                            class={`desktop-parent group w-full
                                    flex items-center justify-between
                                    gap-3
                                    px-4 py-3.5
                                    mb-1
                                    rounded-xl
                                    text-left
                                    text-sm
                                    font-poppins
                                    font-medium
                                    transition-all duration-200
                                    ${
                                        index === 0
                                            ? 'bg-white text-stone-900 shadow-sm'
                                            : 'text-stone-600 hover:bg-white hover:text-stone-900 hover:shadow-sm'
                                    }`}
                        >

                            <span>
                                {categoria.nombre}
                            </span>


                            {categoria.subcategorias.length > 0 && (
                                <span
                                    class={`flex items-center justify-center
                                            w-5 h-5
                                            rounded-full
                                            transition-all duration-200
                                            ${
                                                index === 0
                                                    ? 'text-violet-500'
                                                    : 'text-stone-300 group-hover:text-violet-500'
                                            }`}
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke-width="1.8"
                                        stroke="currentColor"
                                        class="w-4 h-4"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="m9 18 6-6-6-6"
                                        />
                                    </svg>
                                </span>
                            )}

                        </button>
                    ))}

                </div>
                <!-- SUBCATEGORÍAS -->

                <div
                    id="desktop-category-children"
                    class="bg-white
                        overflow-y-auto
                        overscroll-contain
                        p-8"
                >

                    {categorias.hamburguesa.map((categoria, index) => (
                        <div
                            data-category-panel={index}
                            class={index === 0 ? '' : 'hidden'}
                        >

                            <!-- Título de categoría -->

                            <div class="mb-7">

                                <a
                                    href={`/productos?categoria=${categoria.slug}`}
                                    class="inline-flex items-center gap-2
                                        font-fraunces italic
                                        text-2xl
                                        text-stone-800
                                        hover:text-violet-700
                                        transition-colors duration-200"
                                >
                                    {categoria.nombre}

                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke-width="1.5"
                                        stroke="currentColor"
                                        class="w-4 h-4 opacity-40"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="m9 18 6-6-6-6"
                                        />
                                    </svg>
                                </a>

                                <div class="mt-3 w-10 h-px bg-violet-300"></div>

                            </div>


                            {categoria.subcategorias.length > 0 ? (

                                <div
                                    class="grid
                                        grid-cols-[repeat(auto-fit,minmax(180px,1fr))]
                                        gap-x-10
                                        gap-y-8"
                                >

                                    {categoria.subcategorias.map((sub) => (

                                        <div class="min-w-0">

                                            <!-- Subcategoría -->

                                            <a
                                                href={`/productos?categoria=${sub.slug}`}
                                                class="group/sub
                                                    flex items-center gap-1
                                                    text-sm
                                                    font-poppins
                                                    font-semibold
                                                    text-stone-800
                                                    hover:text-violet-700
                                                    transition-colors duration-150"
                                            >
                                                <span>
                                                    {sub.nombre}
                                                </span>

                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    fill="none"
                                                    viewBox="0 0 24 24"
                                                    stroke-width="1.5"
                                                    stroke="currentColor"
                                                    class="w-3.5 h-3.5
                                                        opacity-0
                                                        -translate-x-1
                                                        group-hover/sub:opacity-100
                                                        group-hover/sub:translate-x-0
                                                        transition-all duration-150"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        d="m9 18 6-6-6-6"
                                                    />
                                                </svg>
                                            </a>


                                            <!-- Hijas -->

                                            {sub.subcategorias.length > 0 && (
                                                <div class="mt-3 pl-3 border-l border-stone-200">
                                                    <CategoryMenuList
                                                        categorias={sub.subcategorias}
                                                    />
                                                </div>
                                            )}

                                        </div>

                                    ))}

                                </div>

                            ) : (

                                <p
                                    class="text-sm
                                        font-poppins
                                        text-stone-400"
                                >
                                    No hay subcategorías.
                                </p>

                            )}

                        </div>
                    ))}

                </div>

            </div>

        </div>
    </div>
    <!-- MENÚ HAMBURGUESA MOBILE -->

    <div
        id="mobile-menu"
        class="hidden fixed inset-0 z-50 bg-white"
    >

        <!-- Header del menú -->

        <div
            class="h-16 flex items-center justify-between
                    px-5 border-b border-stone-200"
        >
            <h2 class="font-fraunces italic text-xl text-stone-800">
                Categorías
            </h2>

            <button
                id="mobile-menu-close"
                type="button"
                class="w-9 h-9 flex items-center justify-center
                        rounded-md text-stone-500
                        hover:bg-stone-100 hover:text-stone-900"
                aria-label="Cerrar menú"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-5 h-5"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6 18 18 6M6 6l12 12"
                    />
                </svg>
            </button>
        </div>


        <!-- Lista de categorías -->

        <div
            id="mobile-category-list"
            class="h-[calc(100vh-4rem)] overflow-y-auto"
        >

            <div id="mobile-parents" class="p-4 space-y-1">

                {categorias.hamburguesa.map((categoria, index) => (
                    <button
                        type="button"
                        data-mobile-category={index}
                        class="w-full flex items-center justify-between
                                px-4 py-4 text-left
                                border-b border-stone-100
                                text-sm font-poppins font-medium
                                text-stone-700
                                hover:text-stone-950"
                    >
                        <span>{categoria.nombre}</span>

                        {categoria.subcategorias.length > 0 && (
                            <span class="text-stone-400 text-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                                </svg>
                            </span>
                        )}
                    </button>
                ))}

            </div>


            <!-- Hijas mobile -->

            <div
                id="mobile-children"
                class="hidden"
            >

                <div
                    class="sticky top-0 bg-white
                            border-b border-stone-200
                            px-4 py-3"
                >
                    <button
                        id="mobile-back"
                        type="button"
                        class="flex items-center gap-2
                                text-sm font-poppins font-medium
                                text-stone-600"
                    >
                        <span>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                            </svg>
                        </span>
                        <span>Volver</span>
                    </button>
                </div>

                {categorias.hamburguesa.map((categoria, index) => (
                    <div
                        data-mobile-panel={index}
                        class={`p-5 ${index === 0 ? '' : 'hidden'}`}
                    >

                        <a
                            href={`/productos?categoria=${categoria.slug}`}
                            class="block font-fraunces italic
                                    text-2xl text-stone-800 mb-5"
                        >
                            {categoria.nombre}
                        </a>

                        {categoria.subcategorias.length > 0 ? (
                            <div class="space-y-1">
                                {categoria.subcategorias.map((sub) => (
                                    <a
                                        href={`/productos?categoria=${sub.slug}`}
                                        class="flex items-center justify-between
                                                px-3 py-3
                                                border-b border-stone-100
                                                text-sm font-poppins
                                                text-stone-700"
                                    >
                                        <span>{sub.nombre}</span>
                                        <span class="text-stone-300">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                                            </svg>
                                        </span>
                                    </a>
                                ))}
                            </div>
                        ) : (
                            <p class="text-sm text-stone-400">
                                No hay subcategorías.
                            </p>
                        )}

                    </div>
                ))}

            </div>

        </div>

    </div>

</nav>


<script>
    // DESKTOP

    const desktopMenu = document.getElementById('desktop-menu');
    const desktopToggle = document.getElementById('menu-toggle-desktop');
    const desktopClose = document.getElementById('desktop-menu-close');

    const desktopParents =
        document.querySelectorAll<HTMLElement>('.desktop-parent');

    const desktopPanels =
        document.querySelectorAll<HTMLElement>('[data-category-panel]');


    const openDesktopMenu = () => {
        desktopMenu?.classList.remove('hidden');
        desktopToggle?.setAttribute('aria-expanded', 'true');
    };

    const closeDesktopMenu = () => {
        desktopMenu?.classList.add('hidden');
        desktopToggle?.setAttribute('aria-expanded', 'false');
    };


    desktopToggle?.addEventListener('click', () => {
        if (desktopMenu?.classList.contains('hidden')) {
            openDesktopMenu();
        } else {
            closeDesktopMenu();
        }
    });


    desktopClose?.addEventListener('click', closeDesktopMenu);


    desktopParents.forEach((parent) => {
        parent.addEventListener('mouseenter', () => {
            const index = parent.dataset.categoryIndex;

            desktopParents.forEach((item) => {
                item.classList.remove(
                    'bg-white',
                    'text-stone-900',
                    'shadow-sm'
                );

                item.classList.add(
                    'text-stone-600'
                );
            });

            parent.classList.remove('text-stone-600');

            parent.classList.add(
                'bg-white',
                'text-stone-900',
                'shadow-sm'
            );


            desktopPanels.forEach((panel) => {
                panel.classList.add('hidden');
            });

            const activePanel = document.querySelector(
                `[data-category-panel="${index}"]`
            );

            activePanel?.classList.remove('hidden');
        });
    });

    // MOBILE

    const mobileMenu = document.getElementById('mobile-menu');
    const mobileToggle = document.getElementById('menu-toggle-mobile');
    const mobileClose = document.getElementById('mobile-menu-close');

    const mobileParents =
        document.querySelectorAll<HTMLElement>('[data-mobile-category]');

    const mobilePanels =
        document.querySelectorAll<HTMLElement>('[data-mobile-panel]');

    const mobileParentsContainer =
        document.getElementById('mobile-parents');

    const mobileChildren =
        document.getElementById('mobile-children');

    const mobileBack =
        document.getElementById('mobile-back');


    const openMobileMenu = () => {
        mobileMenu?.classList.remove('hidden');

        document.body.classList.add('overflow-hidden');

        mobileToggle?.setAttribute('aria-expanded', 'true');
    };


    const closeMobileMenu = () => {
        mobileMenu?.classList.add('hidden');

        document.body.classList.remove('overflow-hidden');

        mobileToggle?.setAttribute('aria-expanded', 'false');

        mobileParentsContainer?.classList.remove('hidden');
        mobileChildren?.classList.add('hidden');
    };


    mobileToggle?.addEventListener('click', openMobileMenu);

    mobileClose?.addEventListener('click', closeMobileMenu);


    mobileParents.forEach((parent) => {
        parent.addEventListener('click', () => {
            const index = parent.dataset.mobileCategory;

            const panel = document.querySelector(
                `[data-mobile-panel="${index}"]`
            );

            if (!panel) return;

            mobileParentsContainer?.classList.add('hidden');
            mobileChildren?.classList.remove('hidden');

            mobilePanels.forEach((item) => {
                item.classList.add('hidden');
            });

            panel.classList.remove('hidden');

            mobileChildren?.scrollTo({
                top: 0,
                behavior: 'instant',
            });
        });
    });


    mobileBack?.addEventListener('click', () => {
        mobileParentsContainer?.classList.remove('hidden');
        mobileChildren?.classList.add('hidden');
    });


    // Cerrar desktop haciendo click afuera

    document.addEventListener('click', (event) => {
        const target = event.target as Node;

        if (
            desktopMenu &&
            !desktopMenu.contains(target) &&
            !desktopToggle?.contains(target)
        ) {
            closeDesktopMenu();
        }
    });
</script>