---
    import CartIndicator from '../CartIndicator.tsx';
    import { Picture } from 'astro:assets';
    import logo from '../../../public/logo/mariam_isotipo_transparente.png';
    import Navbar from './Navbar.astro';
    import FavoritosIndicator from '../FavoritosIndicator.tsx';
---

<header class="border-b border-stone-200 bg-white sticky top-0 z-20">
    <div class="max-w-7xl mx-auto px-4">
        <!-- Fila superior: buscador (izquierda) / logo (centro) / íconos (derecha) -->
        <div class="h-20 flex items-center gap-6">
            <form action="/productos" method="get" class="hidden md:flex flex-1">
                <div class="relative w-full max-w-xs">
                    <svg
                        class="absolute left-2.5 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-400 pointer-events-none"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <circle cx="11" cy="11" r="7" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                    <input
                        type="text"
                        name="busqueda"
                        placeholder="Buscar perfumes, marcas..."
                        class="w-full border border-stone-300 rounded-md pl-9 pr-3 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-violet-400 transform transition-all duration-200"
                    />
                </div>
            </form>

            <a href="/" class="cursor-pointer">
                <Picture
                    src={logo}
                    alt="Mariam"
                    width={160}
                    height={60}
                    class="flex-1"
                />
            </a>

            <div class="flex-1 flex items-center justify-end gap-5">
                
                <FavoritosIndicator client:load />

                <a
                    href="/mi-cuenta"
                    class="text-stone-600 hover:text-stone-900"
                    aria-label="Mi cuenta"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" />
                    </svg>
                </a>

                <CartIndicator client:load />
            </div>
        </div>
    </div>

    <!-- Fila inferior: navegación de categorías -->
    <Navbar />
</header>