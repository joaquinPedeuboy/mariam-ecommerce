---
    import { Image } from 'astro:assets';
    import type { ProductoListItem } from '../schemas/producto';

    interface Props {
        producto: ProductoListItem;
    }

    const { producto } = Astro.props;
    const apiUrl = import.meta.env.PUBLIC_API_URL.replace('/api', '');
---
<a
    href={`/productos/${producto.slug}`}
    class="block bg-white border border-stone-200 rounded-lg overflow-hidden hover:shadow-md transition-shadow"
>
    <div class="aspect-square bg-stone-100 relative">
        {producto.porcentaje_descuento && (
            <span class="absolute top-2 left-2 bg-red-600 text-white text-xs font-bold px-2 py-1 rounded-md z-10">
                -{producto.porcentaje_descuento}%
            </span>
        )}
        {producto.imagen && (
            <Image
                src={`${apiUrl}/storage/${producto.imagen}`}
                alt={producto.nombre}
                width={400}
                height={400}
                loading="lazy"
                class="w-full h-full object-cover"
            />
        )}
    </div>
    <div class="p-4">
        <h3 class="text-sm font-medium text-stone-900 line-clamp-2">{producto.nombre}</h3>
        <p class="text-lg font-semibold text-stone-900 mt-1">
            {producto.precio_oferta ? (
                <>
                    <span class="line-through text-stone-500 mr-2">
                        ${producto.precio.toLocaleString('es-AR')}
                    </span>
                    <span class="text-black font-bold">
                        ${producto.precio_oferta.toLocaleString('es-AR')}
                    </span>
                </>
            ) : (
                <>${producto.precio.toLocaleString('es-AR')}</>
            )}
        </p>
        {producto.stock === 0 && (
            <p class="text-xs text-red-600 mt-1">Sin stock</p>
        )}
    </div>
</a>